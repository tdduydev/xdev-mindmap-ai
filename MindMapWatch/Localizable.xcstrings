      }
    },
    "Turn on iCloud for MindMap AI on your iPhone to see your maps here. Ideas you add are kept on this watch until then." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bật iCloud cho MindMap AI trên iPhone để xem sơ đồ ở đây. Đến lúc đó, ý tưởng bạn thêm được giữ trên đồng hồ này."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにマップを表示するには、iPhoneでMindMap AIのiCloudをオンにしてください。それまでは、追加したアイデアはこのApple Watchに保存されます。"
          }
        }
      }
    },
    "Your maps can't be opened on this watch right now." : {
