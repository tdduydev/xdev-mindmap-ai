    "A one-time purchase, not a subscription. Payment is charged to your Apple Account.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần, không phải gói đăng ký. Khoản thanh toán được tính vào Tài khoản Apple của bạn."
          }
        }
      }
    },
    "AI": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "AI can make mistakes. Suggestions change your map only when you accept them, and Undo takes them back.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI có thể sai. Đề xuất chỉ thay đổi sơ đồ khi bạn chấp nhận, và Hoàn tác sẽ gỡ chúng đi."
          }
        }
      }
    },
    "AI runs on this device": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI chạy trên thiết bị này"
          }
        }
      }
    },
    "AI runs on this device. Your maps and requests are never sent to xDev.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI chạy trên thiết bị này. Sơ đồ và yêu cầu của bạn không bao giờ được gửi tới xDev."
          }
        }
      }
    },
