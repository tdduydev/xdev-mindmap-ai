    "A backup is a whole map. Choose File ▸ Import… to open it as a new map." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップはマップ全体です。「ファイル」▸「読み込む…」を選択すると、新しいマップとして開けます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu là cả một sơ đồ. Chọn Tệp ▸ Nhập… để mở nó thành sơ đồ mới."
          }
        }
      }
    },
    "A one-time purchase, not a subscription. Payment is charged to your Apple Account." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションではなく、1回限りの購入です。支払いはApple Accountに請求されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mua một lần, không phải gói đăng ký. Khoản thanh toán được tính vào Tài khoản Apple của bạn."
          }
        }
      }
    },
    "A tag name needs 1 to 40 characters." : {
      "localizations" : {
        "ja" : {
