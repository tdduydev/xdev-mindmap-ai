    "MindMap AI imports Markdown (.md), plain text (.txt), OPML (.opml) and FreeMind or Freeplane (.mm) files, and its own backups (.json)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI imports Markdown (.md), plain text (.txt), OPML (.opml) and FreeMind or Freeplane (.mm) files, and its own backups (.json)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AIで読み込めるのは、Markdown (.md) ファイル、プレーンテキスト (.txt) ファイル、OPML (.opml) ファイル、FreeMindまたはFreeplane (.mm) ファイル、およびMindMap AIのバックアップ (.json) です。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI nhập tệp Markdown (.md), văn bản thuần (.txt), OPML (.opml), FreeMind hoặc Freeplane (.mm) và bản sao lưu của chính ứng dụng (.json)."
          }
        }
      }
    },
    "The file isn’t an OPML outline. MindMap AI imports OPML files from outliners and other mind map apps, Markdown (.md) and plain text (.txt)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file isn’t an OPML outline. MindMap AI imports OPML files from outliners and other mind map apps, Markdown (.md) and plain text (.txt)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはOPMLのアウトラインではありません。MindMap AIで読み込めるのは、アウトライナーやほかのマインドマップAppのOPMLファイル、Markdown (.md)、プレーンテキスト (.txt) です。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp không phải dàn ý OPML. MindMap AI nhập tệp OPML từ ứng dụng dàn ý và ứng dụng sơ đồ tư duy khác, Markdown (.md) và văn bản thuần (.txt)."
          }
        }
      }
    },
