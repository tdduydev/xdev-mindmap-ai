      "shouldTranslate" : false
    },
    "MindMap AI can’t use speech recognition. Turn it on in Privacy & Security settings." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI không dùng được nhận dạng giọng nói. Hãy bật trong cài đặt Quyền riêng tư & Bảo mật."
          }
        }
      }
    },
    "MindMap AI can’t use the microphone. Turn it on in Privacy & Security settings." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI không dùng được micro. Hãy bật trong cài đặt Quyền riêng tư & Bảo mật."
          }
        }
      }
    },
    "MindMap AI couldn’t open its storage. Restart the app. If it keeps happening, contact xDev support." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI không mở được nơi lưu dữ liệu. Hãy khởi động lại ứng dụng. Nếu vẫn lỗi, hãy liên hệ hỗ trợ của xDev."
          }
        }
      }
    },
    "MindMap AI couldn’t read the file. Check that it opens in another app, then try again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI không đọc được tệp. Hãy kiểm tra tệp mở được bằng ứng dụng khác rồi thử lại."
          }
        }
      }
    },
    "MindMap AI imports Markdown (.md) and plain text (.txt) files, and its own backups (.json)." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI nhập tệp Markdown (.md), văn bản thuần (.txt) và bản sao lưu của chính ứng dụng (.json)."
          }
        }
      }
    },
    "MindMap AI keeps your maps on your devices. There is no account and no tracking." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI giữ sơ đồ trên thiết bị của bạn. Không cần tài khoản, không theo dõi."
          }
        }
      }
    },
    "MindMap AI must be open for AI apps to read your maps. Each app gets its own token, so you can revoke one without the others." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MindMap AI phải đang mở thì ứng dụng AI mới đọc được sơ đồ. Mỗi ứng dụng có mã truy cập riêng, nên bạn thu hồi được từng ứng dụng."
          }
        }
      }
    },
    "MindMap AI uses Apple Intelligence on this device. Your maps and requests are processed here and are never sent to xDev." : {
      "localizations" : {
