    "Text and lines stay sharp at any zoom, and the text can be searched." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの拡大率でも文字や線がくっきり表示され、文字を検索できます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
