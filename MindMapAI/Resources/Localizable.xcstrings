    "%@ can no longer read your maps. To connect it again, add it again and paste the new setup." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ không đọc được sơ đồ của bạn nữa. Muốn kết nối lại, hãy thêm lại và dán thiết lập mới."
          }
        }
      }
    },
