        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở sơ đồ ${applicationName} gần đây"
          }
        }
      }
    },
    "Start a ${applicationName} map" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${applicationName}でマップを始める"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu sơ đồ ${applicationName}"
