{
  "sourceLanguage" : "en",
  "strings" : {
    "Add an idea to ${applicationName}" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${applicationName}にアイデアを追加"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm ý tưởng vào ${applicationName}"
          }
        }
      }
    },
    "Make a ${applicationName} map from the clipboard" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードから${applicationName}のマップを作成"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo sơ đồ ${applicationName} từ bảng nhớ tạm"
          }
        }
      }
    },
    "New map in ${applicationName}" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${applicationName}で新規マップ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sơ đồ mới trong ${applicationName}"
          }
        }
      }
    },
    "Open my recent ${applicationName} map" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${applicationName}で最近のマップを開く"
